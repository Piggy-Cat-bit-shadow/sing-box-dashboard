{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // `@shared` is the desktop shell's own alias for `clients/desktop/src/shared`
    // (`../tsconfig.web.json`, and the renderer half of `../electron.vite.config.ts`). It is
    // repeated here because the Subscription-Userinfo parser lives in that directory - it
    // belongs where the fetch happens - while the test that exercises it lives here, where the
    // repository's only test runner is. `vite.config.ts` declares the same alias for vitest.
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src", "../src/shared/subscription.ts"]
}
